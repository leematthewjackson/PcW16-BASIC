' DBPROBE (M10): the database statements on Rosanne, step by step.
' Only the disposable files DBPROBE.PDB, DBPROBE.NEW, DBPROBE.BAK and
' DBPROBE.TXT in the program's folder (\PCW\FOLDER01) are written,
' renamed or deleted; run it on a disk where those names hold nothing of
' value. Each step shows one alert; the expected text is in
' docs/M10-ACCEPTANCE.md (D0-D8). The steps:
'   D0 clean up (old DBPROBE files gone)
'   D1 40 records made and saved            (IOERR 0)
'   D2 loaded back and checked              (multi-byte reads ending at the
'      end of the file: the H-EOF hypothesis)
'   D3 a second save keeps DBPROBE.BAK      (IOERR 0 and the .BAK opens)
'   D4 the file deleted: loaded from .BAK   (DBRECOVERED 2)
'   D5 only DBPROBE.NEW: loaded from it     (DBRECOVERED 1)
'   D6 a file that is not a database        (IOERR 248, nothing else there)
'   D7 sort and search 200 records          (time it with a watch)
'   D8 clean up
TYPE Rec
    Id AS INTEGER
    Name AS STRING * 20
    Value AS INTEGER
END TYPE
DIM R(200) AS Rec BANKED
DIM O(200) AS INTEGER
DIM N AS INTEGER
DIM F AS INTEGER
DIM I AS INTEGER
DIM S AS INTEGER
DIM E AS INTEGER
DIM T$ AS STRING

SUB Clean
    KILL "DBPROBE.PDB"
    KILL "DBPROBE.NEW"
    KILL "DBPROBE.BAK"
    KILL "DBPROBE.TXT"
END SUB

SUB Make(Count AS INTEGER)
    N = 0
    FOR I = 1 TO Count
        DB NEW R, N
        R(N).Name = "Rec " + STR$(201 - I)
        R(N).Value = I
    NEXT I
END SUB

FUNCTION Sum() AS INTEGER
    LOCAL K AS INTEGER
    LOCAL Total AS INTEGER
    Total = 0
    FOR K = 1 TO N
        Total = Total + R(K).Value
    NEXT K
    RETURN Total + N
END FUNCTION

SUB Report(Step$ AS STRING)
    MESSAGE Step$ + " io=" + STR$(E) + " n=" + STR$(N) + " rec=" + STR$(DBRECOVERED) + " sum=" + STR$(Sum()) + " next=" + STR$(DBNEXTID(R))
END SUB

CALL Clean
MESSAGE "D0 clean"
CALL Make(40)
DB SAVE R, N, "DBPROBE.PDB"
E = IOERR
CALL Report("D1")
N = 0
DB LOAD R, N, "DBPROBE.PDB"
E = IOERR
CALL Report("D2")
DB SAVE R, N, "DBPROBE.PDB"
E = IOERR
OPEN "DBPROBE.BAK" FOR INPUT AS #1
S = IOERR
CLOSE #1
MESSAGE "D3 io=" + STR$(E) + " bak=" + STR$(S)
KILL "DBPROBE.PDB"
DB LOAD R, N, "DBPROBE.PDB"
E = IOERR
CALL Report("D4")
NAME "DBPROBE.BAK" AS "DBPROBE.NEW"
DB LOAD R, N, "DBPROBE.PDB"
E = IOERR
CALL Report("D5")
KILL "DBPROBE.NEW"
OPEN "DBPROBE.TXT" FOR OUTPUT AS #1
PRINT #1, "This is not a database, but it is long enough to hold a header."
CLOSE #1
NAME "DBPROBE.TXT" AS "DBPROBE.PDB"
DB LOAD R, N, "DBPROBE.PDB"
E = IOERR
CALL Report("D6")
CALL Make(200)
MESSAGE "D7 start: press OK and time until the next alert"
DB SORT R, N, O, Name, NOCASE
T$ = R(O(1)).Name + "/" + R(O(200)).Name
DB SEARCH R, N, O, F, Name, "9"
MESSAGE "D7 done " + T$ + " found=" + STR$(F)
CALL Clean
MESSAGE "D8 clean"
END
