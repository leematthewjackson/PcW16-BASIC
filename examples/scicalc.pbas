' Scientific calculator (M7 example): REAL numbers and the maths functions.
' Type x (and y for the two-number operations), pick an operation and
' click "=". Every input is checked with ISNUM, and every domain or range
' problem is reported in the window instead of stopping the program (the
' runtime would stop with an error, LANGUAGE-SPEC §3.1 / §8).
' Use copies the result into x; Swap exchanges x and y; Store / Recall
' keep one number in memory. Degrees switches SIN/COS/TAN/ATN to degrees.
' Uses: REAL, REALVAL, ISNUM, STR$, FUNCTION/SUB with REAL parameters,
' SELECT CASE, CONST, CHOICE, CHECKBOX. No files.
CONST BIG = 88.7
DIM Ops$(13) AS STRING
DIM X AS REAL
DIM Y AS REAL
DIM R AS REAL
DIM Memory AS REAL
DIM Ok AS BOOLEAN
DIM Why$ AS STRING
DIM Result$ AS STRING
DIM Mem$ AS STRING
DIM T$ AS STRING
WINDOW "Scientific calculator", LARGE
TEXTBOX X$, "x"
TEXTBOX Y$, "y"
CHOICE Op, Ops$, 13, "Operation"
CHECKBOX Degrees, "Degrees for SIN COS TAN ATN"
LABEL Result$
LABEL Mem$
BUTTON "=", Calculate, DEFAULT
BUTTON "Use", UseResult
BUTTON "Swap", SwapXY
BUTTON "Store", StoreIt
BUTTON "Recall", RecallIt
BUTTON "Quit", Finish, KEY STOP

' TRUE when ln|a| + ln|b| (a, b <> 0) shows a * b would exceed the REAL range.
FUNCTION ProductTooBig(A AS REAL, B AS REAL) AS BOOLEAN
    IF A = 0 OR B = 0 THEN
        RETURN FALSE
    END IF
    RETURN LOG(ABS(A)) + LOG(ABS(B)) > BIG
END FUNCTION

FUNCTION Radians(A AS REAL) AS REAL
    IF Degrees THEN
        RETURN A * PI / 180
    END IF
    RETURN A
END FUNCTION

SUB Fail(Text$)
    Ok = FALSE
    Why$ = Text$
END SUB

SUB ReadNumber(Text$, Name$)
    IF NOT ISNUM(Text$) THEN
        CALL Fail(Name$ + " is not a number")
    END IF
END SUB

SUB Power
    LOCAL L AS REAL
    IF X = 0 THEN
        IF Y < 0 THEN
            CALL Fail("0 ^ negative")
        ELSE
            IF Y = 0 THEN
                R = 1
            ELSE
                R = 0
            END IF
        END IF
        EXIT SUB
    END IF
    IF X < 0 AND FIX(Y) <> Y THEN
        CALL Fail("negative ^ fraction")
        EXIT SUB
    END IF
    L = LOG(ABS(X))
    IF L <> 0 THEN
        IF ABS(Y) > BIG / ABS(L) AND (Y > 0) = (L > 0) THEN
            CALL Fail("result too large")
            EXIT SUB
        END IF
    END IF
    R = X ^ Y
END SUB

SUB Calculate
    LOCAL Code AS INTEGER
    Ok = TRUE
    CALL ReadNumber(X$, "x")
    IF NOT Ok THEN
        Result$ = Why$
        EXIT SUB
    END IF
    X = REALVAL(X$)
    IF Op <= 5 THEN
        CALL ReadNumber(Y$, "y")
        IF NOT Ok THEN
            Result$ = Why$
            EXIT SUB
        END IF
        Y = REALVAL(Y$)
    END IF
    SELECT CASE Op
    CASE 1, 2
        IF ABS(X) > 1E37 OR ABS(Y) > 1E37 THEN
            IF Op = 2 THEN
                Y = -Y
            END IF
            IF X / 2 + Y / 2 > 8.5E37 OR X / 2 + Y / 2 < -8.5E37 THEN
                CALL Fail("result too large")
            ELSE
                R = X + Y
            END IF
        ELSE
            IF Op = 1 THEN
                R = X + Y
            ELSE
                R = X - Y
            END IF
        END IF
    CASE 3
        IF ProductTooBig(X, Y) THEN
            CALL Fail("result too large")
        ELSE
            R = X * Y
        END IF
    CASE 4
        IF Y = 0 THEN
            CALL Fail("division by zero")
        ELSE
            IF X <> 0 AND LOG(ABS(X)) - LOG(ABS(Y)) > BIG THEN
                CALL Fail("result too large")
            ELSE
                R = X / Y
            END IF
        END IF
    CASE 5
        CALL Power
    CASE 6
        IF X < 0 THEN
            CALL Fail("SQR of a negative")
        ELSE
            R = SQR(X)
        END IF
    CASE 7
        IF X > 88 THEN
            CALL Fail("result too large")
        ELSE
            R = EXP(X)
        END IF
    CASE 8, 9
        IF X <= 0 THEN
            CALL Fail("LOG needs x > 0")
        ELSE
            R = LOG(X)
            IF Op = 9 THEN
                R = R / LOG(10.0)
            END IF
        END IF
    CASE 10, 11, 12
        IF ABS(Radians(X)) > 51000.0 THEN
            CALL Fail("angle too large")
        ELSE
            SELECT CASE Op
            CASE 10
                R = SIN(Radians(X))
            CASE 11
                R = COS(Radians(X))
            CASE ELSE
                R = TAN(Radians(X))
            END SELECT
        END IF
    CASE ELSE
        R = ATN(X)
        IF Degrees THEN
            R = R * 180 / PI
        END IF
    END SELECT
    IF Ok THEN
        Result$ = "= " + STR$(R)
    ELSE
        Result$ = Why$
    END IF
END SUB

SUB UseResult
    X$ = STR$(R)
END SUB

SUB SwapXY
    T$ = X$
    X$ = Y$
    Y$ = T$
END SUB

SUB StoreIt
    Memory = R
    Mem$ = "M = " + STR$(Memory)
END SUB

SUB RecallIt
    X$ = STR$(Memory)
END SUB

SUB Finish
    EXIT
END SUB

Ops$(1) = "x + y"
Ops$(2) = "x - y"
Ops$(3) = "x * y"
Ops$(4) = "x / y"
Ops$(5) = "x ^ y"
Ops$(6) = "SQR x"
Ops$(7) = "EXP x"
Ops$(8) = "LOG x (natural)"
Ops$(9) = "LOG10 x"
Ops$(10) = "SIN x"
Ops$(11) = "COS x"
Ops$(12) = "TAN x"
Ops$(13) = "ATN x"
Op = 1
Mem$ = "M = 0"
END
