' MDEDIT IV (M12 Stage E): MDEDIT III (examples/mdedit3.pbas, accepted in
' M11 and unchanged) with word wrapping by pixel width.
' With wrap on (the start), a long line continues on the next rows, each
' row ending between words: the row holds the most characters that fit the
' page's width as Rosanne draws them (TEXTWIDTH), back to just after the
' last space among them; a word longer than a row is broken where it stops
' fitting. Up and Down move by rows, keeping the caret's x through a run of
' presses; a click, typing and every other editing key work as in MDEDIT
' III. Typing re-measures only the rows it can change. With wrap off
' (Ctrl+W) the page scrolls sideways as in MDEDIT III.
'
' Keys (on the editing page): letters, digits and symbols type; Return splits
' the line; Backspace / Delete delete one character, or the selection;
' cursor keys, Home, End, PgUp, PgDn move; with Shift held they extend the
' selection (also after Mark - Edit > Mark, Ctrl+K or f1 - until the next
' edit or Mark again); Tab types 4 spaces; Stop quits. Keys held with Ctrl
' belong to the menus and never type (KI-60).
' Mouse: press and drag over the text to select it; a click moves the caret.
' Menus: Ctrl+X cut, Ctrl+C copy, Ctrl+V paste, Ctrl+A select all (the
' page stays where it is), Ctrl+K mark, Ctrl+Z undo, Ctrl+Y redo, Ctrl+W wrap,
' Ctrl+S save, Ctrl+O open, Ctrl+F find / replace, Ctrl+G find next,
' Ctrl+L go to line, Ctrl+Q quit; Ctrl+Home / Ctrl+End go to the top / end.
' Home and End go to the line's start and end; PgUp and PgDn move 13 lines.
'
' Undo keeps the last 4 steps. A step is a run of typing on one line, a
' run of deletions, a line split or join, a cut, a paste, a replacement or
' a "replace all". Each step costs one copy of the whole text.
'
' Saving (in the build folder, \PCW\FOLDER01 by default) writes MDEDIT4.TMP,
' reads it back and compares it with the text, then keeps the previous file
' as NAME.BAK (an older NAME.BAK is replaced) and renames MDEDIT4.TMP to the
' file. If any step fails the old file is still there (or in NAME.BAK) and
' the text is still in MDEDIT4.TMP. It starts with EDTEST.MD.
' M14 version of examples/mdedit4.pbas (KI-97, M14-DEFECT-REGISTER F8). The
' accepted program lost text after a failed final rename: the next session's
' first save wrote over MDEDIT4.TMP, and when the file itself was missing it
' also deleted NAME.BAK. Now: at start an MDEDIT4.TMP left by an unfinished
' save is renamed MDEDIT4.OLD and an alert says so (open it to recover it);
' if MDEDIT4.OLD is there too, nothing is renamed and saving is refused until
' one of them is deleted or renamed (Rosanne's file manager). A save keeps
' NAME.BAK when NAME itself is missing: it renames NAME to NAME.BAK first and
' deletes the old NAME.BAK only when that rename fails for another reason
' than a missing file (onto an existing name it is IOERR 80), then renames.
' mdedit4.pbas is kept as accepted (M12).
'
' Limits: 30000 bytes of text (the clipboard too); 13 rows; a row holds at
' most 120 characters. The page is measured with one TEXTWIDTH call per
' character edge it tries (about 8 a row), so a page measured whole costs
' about 100 calls; typing usually re-measures one or two rows.
' Build with --runtime-banks all (python3 tools/build.py examples/mdedit4.pbas --runtime-banks all)
' M15 version of examples/mdedit4_m14.pbas: ON STOP MayDiscard, so Rosanne's Tasks > Stop
' (which since M15 ends a program with menus) first asks about unsaved changes, as
' Quit does; Cancel keeps the program open (LANGUAGE-SPEC 6.1, KI-35). Otherwise the same.
CONST ROWS = 13
CONST COLS = 50
CONST ROWMAX = 120
CONST EOLW = 6
CONST TEXTW = 552
CONST LINEH = 16
CONST STEPS = 4
CONST TEMPNAME = "MDEDIT4.TMP"
CONST OLDNAME = "MDEDIT4.OLD"
DIM Doc AS TEXT * 30000
DIM Clip AS TEXT * 30000
DIM H1 AS TEXT * 30000
DIM H2 AS TEXT * 30000
DIM H3 AS TEXT * 30000
DIM H4 AS TEXT * 30000
DIM Swap AS TEXT * 30000
DIM HLine(4) AS INTEGER
DIM HCol(4) AS INTEGER
DIM HTop AS INTEGER
DIM UndoN AS INTEGER
DIM RedoN AS INTEGER
DIM LastKind AS INTEGER
DIM LastLine AS INTEGER
DIM Status$ AS STRING * 25
DIM Info$ AS STRING * 24
DIM FileName$ AS STRING * 13
DIM DocName$ AS STRING * 13
DIM Target$ AS STRING * 13
DIM BakName$ AS STRING * 13
DIM InTemp AS BOOLEAN
DIM Stale AS BOOLEAN
DIM FindText$ AS STRING * 40
DIM ReplText$ AS STRING * 40
DIM GoLine AS INTEGER
DIM CurLine AS INTEGER
DIM CurCol AS INTEGER
DIM TopLine AS INTEGER
DIM LeftCol AS INTEGER
DIM Wrap AS BOOLEAN
DIM SelOn AS BOOLEAN
DIM Marking AS BOOLEAN
DIM AncLine AS INTEGER
DIM AncCol AS INTEGER
DIM S1 AS INTEGER
DIM C1 AS INTEGER
DIM S2 AS INTEGER
DIM C2 AS INTEGER
DIM Seg$ AS STRING * 120
DIM Dragging AS BOOLEAN
DIM Answer AS INTEGER
DIM Redraw AS BOOLEAN
DIM N AS INTEGER
' M12: the page table (RowStart), the new rows of RelayoutLine, a
' measured row, and the state of wrapping
DIM Brk$ AS STRING * 120
DIM TopCol AS INTEGER
DIM PgL(13) AS INTEGER
DIM PgC(13) AS INTEGER
DIM PgE(13) AS INTEGER
DIM PgLast(13) AS BOOLEAN
DIM PgDirty(13) AS BOOLEAN
DIM NewC(13) AS INTEGER
DIM NewE(13) AS INTEGER
DIM NewLast(13) AS BOOLEAN
DIM BrLast AS BOOLEAN
DIM NL AS INTEGER
DIM NS AS INTEGER
DIM NeedLayout AS BOOLEAN
DIM EdOne AS BOOLEAN
DIM EdLine AS INTEGER
DIM EdCol AS INTEGER
DIM EdDelta AS INTEGER
DIM GoalOn AS BOOLEAN
DIM GoalX AS INTEGER

WINDOW Main, "MDEDIT IV", LARGE
LABEL Status$
CANVAS 560, 208, PAINT Paint, MOUSE Mouse, KEYS Keys
LABEL Info$
BUTTON "Save", SaveDoc
BUTTON "Find next", FindNext
BUTTON "Files...", ShowTools
BUTTON "Quit", QuitEditor

WINDOW Tools, "Files", LARGE
TEXTBOX FileName$, "File name (8.3)"
NUMBERBOX GoLine, "Go to line", MIN 1
BUTTON "Open", OpenDoc
BUTTON "Save as", SaveAs
BUTTON "Go to", GoToLine
BUTTON "Back", BackToMain

WINDOW Finder, "Find and replace", LARGE
TEXTBOX FindText$, "Find"
TEXTBOX ReplText$, "Replace with"
BUTTON "Find", FindFirst
BUTTON "Replace", ReplaceOne
BUTTON "Replace all", ReplaceAll
BUTTON "Back", BackToMain

MENU "File"
    ITEM "Open...", ShowTools, KEY "O"
    ITEM "Save", SaveDoc, KEY "S"
    ITEM "Quit", QuitEditor, KEY "Q"
END MENU
MENU "Edit"
    ITEM "Undo", UndoStep, KEY "Z"
    ITEM "Redo", RedoStep, KEY "Y"
    ITEM "-"
    ITEM "Cut", CutSel, KEY "X"
    ITEM "Copy", CopySel, KEY "C"
    ITEM "Paste", PasteClip, KEY "V"
    ITEM "Select all", SelectAll, KEY "A"
    ITEM "Mark", MarkSel, KEY "K"
    ITEM "-"
    ITEM "Find...", ShowFinder, KEY "F"
    ITEM "Find next", FindNext, KEY "G"
    ITEM "Go to...", ShowTools, KEY "L"
END MENU
MENU "View"
    ITEM "Wrap on/off", ToggleWrap, KEY "W"
END MENU
ON STOP MayDiscard  ' M15: Rosanne's Tasks > Stop asks about unsaved changes first

' ------------------------------------------------------------ selection
' S1/C1 .. S2/C2 = the selection in text order (anchor and caret sorted).
SUB SelRange
    IF AncLine < CurLine OR (AncLine = CurLine AND AncCol <= CurCol) THEN
        S1 = AncLine
        C1 = AncCol
        S2 = CurLine
        C2 = CurCol
    ELSE
        S1 = CurLine
        C1 = CurCol
        S2 = AncLine
        C2 = AncCol
    END IF
END SUB

FUNCTION HasSel() AS BOOLEAN
    IF NOT SelOn THEN
        RETURN FALSE
    END IF
    RETURN AncLine <> CurLine OR AncCol <> CurCol
END FUNCTION

SUB ClearSel
    IF SelOn THEN
        Redraw = TRUE
    END IF
    SelOn = FALSE
    Marking = FALSE
END SUB

' Before a caret movement: Shift (or Mark) extends the selection, else it goes.
SUB BeforeMove
    IF (KEYSHIFT AND 1) <> 0 OR Marking THEN
        IF NOT SelOn THEN
            SelOn = TRUE
            AncLine = CurLine
            AncCol = CurCol
        END IF
    ELSE
        CALL ClearSel
    END IF
    LastKind = 0
END SUB

' ------------------------------------------------------------ drawing
' Row Row of the page shows line RLine from column RCol; with wrap RNext is
' where its row ends (the next row's first column) and RLast tells that it
' is the line's last row (RNext is then the line's length + 1).
DIM RLine AS INTEGER
DIM RCol AS INTEGER
DIM RNext AS INTEGER
DIM RLast AS BOOLEAN

' ------------------------------------------------------------ wrapping
' (M12) With wrap on, a row holds the most characters that fit TEXTW
' pixels (TEXTWIDTH), back to just after the last space among them and the
' character after them, so that rows end between words. A space at the end
' of a row may hang past the edge (it is not drawn). A word longer than a
' row is broken where it stops fitting. A row holds at most ROWMAX
' characters. The page table PgL / PgC / PgE / PgLast (rows 1 .. ROWS)
' records each page row's line, first column, end and whether it is its
' line's last row (PgL 0: below the text); TopLine / TopCol is the first.

' The column where line L's row starting at column S ends (the next row's
' first column); BrLast: it is the line's last row (the result is then the
' line's length + 1).
FUNCTION NextBreak(L AS INTEGER, S AS INTEGER) AS INTEGER
    LOCAL N AS INTEGER
    LOCAL Lo AS INTEGER
    LOCAL Hi AS INTEGER
    LOCAL M AS INTEGER
    LOCAL P AS INTEGER
    LOCAL Size AS INTEGER
    Size = TEXTLEN(Doc, L)
    BrLast = TRUE
    IF S > Size THEN
        RETURN Size + 1
    END IF
    Brk$ = TEXTGET$(Doc, L, S, ROWMAX)
    N = LEN(Brk$)
    IF TEXTWIDTH(Brk$) <= TEXTW THEN
        IF S + N > Size THEN
            RETURN Size + 1             ' the rest of the line fits
        END IF
    ELSE
        Lo = 0                          ' Lo characters fit, Hi do not
        Hi = N
        WHILE Hi - Lo > 1
            M = (Lo + Hi) / 2
            IF TEXTWIDTH(LEFT$(Brk$, M)) <= TEXTW THEN
                Lo = M
            ELSE
                Hi = M
            END IF
        WEND
        N = Lo
    END IF
    BrLast = FALSE
    P = MIN(N + 1, LEN(Brk$))
    WHILE P > 0
        IF MID$(Brk$, P, 1) = " " THEN
            EXIT WHILE
        END IF
        P = P - 1
    WEND
    IF P = 0 THEN
        P = MAX(N, 1)                   ' one word longer than a row
    END IF
    IF S + P > Size THEN
        BrLast = TRUE                   ' only a hanging space was left
        RETURN Size + 1
    END IF
    RETURN S + P
END FUNCTION

' The first column of the row of line L that holds column Col.
FUNCTION RowOf(L AS INTEGER, Col AS INTEGER) AS INTEGER
    LOCAL S AS INTEGER
    LOCAL E AS INTEGER
    S = 1
    WHILE 1 = 1
        E = NextBreak(L, S)
        IF BrLast OR Col < E THEN
            RETURN S
        END IF
        S = E
    WEND
    RETURN S
END FUNCTION

' NL / NS: the line and first column of the row after page row R (NL 0:
' none).
SUB After(R AS INTEGER)
    NL = 0
    NS = 1
    IF PgL(R) = 0 THEN
        EXIT SUB
    END IF
    IF PgLast(R) THEN
        NL = PgL(R) + 1
    ELSE
        NL = PgL(R)
        NS = PgE(R)
    END IF
    IF NL > TEXTLINES(Doc) THEN
        NL = 0
        NS = 1
    END IF
END SUB

' Page row R shows line L from S (L 0: nothing); its end is measured.
SUB SetRow(R AS INTEGER, L AS INTEGER, S AS INTEGER)
    PgDirty(R) = TRUE
    PgL(R) = L
    PgC(R) = S
    IF L = 0 THEN
        PgE(R) = 1
        PgLast(R) = TRUE
        EXIT SUB
    END IF
    PgE(R) = NextBreak(L, S)
    PgLast(R) = BrLast
END SUB

SUB CopyRow(R AS INTEGER, From AS INTEGER)
    PgL(R) = PgL(From)
    PgC(R) = PgC(From)
    PgE(R) = PgE(From)
    PgLast(R) = PgLast(From)
    PgDirty(R) = TRUE
END SUB

' Measure the page from row From down (From 1: from TopLine / TopCol).
SUB Layout(From AS INTEGER)
    LOCAL R AS INTEGER
    IF From = 1 THEN
        NL = TopLine
        NS = TopCol
    ELSE
        CALL After(From - 1)
    END IF
    FOR R = From TO ROWS
        CALL SetRow(R, NL, NS)
        CALL After(R)
    NEXT R
END SUB

' TopLine / TopCol after the text changed: a line that exists, and the
' start of a row of it.
SUB FixTop
    TopLine = MIN(MAX(1, TopLine), TEXTLINES(Doc))
    IF TopCol > 1 THEN
        TopCol = RowOf(TopLine, MIN(TopCol, TEXTLEN(Doc, TopLine) + 1))
    END IF
END SUB

' The page row (1 .. ROWS) that shows the caret, or 0.
FUNCTION CaretAt() AS INTEGER
    LOCAL R AS INTEGER
    FOR R = 1 TO ROWS
        IF PgL(R) = CurLine AND PgC(R) <= CurCol THEN
            IF CurCol < PgE(R) OR PgLast(R) THEN
                RETURN R
            END IF
        END IF
    NEXT R
    RETURN 0
END FUNCTION

' After an edit inside line L at column Col that changed its length by
' Delta (typing, deleting a character): measure again from the row before
' the one holding Col (no earlier row can change), only until a row starts
' where it did before, shifted by Delta, after Col (from there the rows
' are the same); then move the rows below if the line now takes more or
' fewer rows. Changed rows are marked PgDirty.
SUB RelayoutLine(L AS INTEGER, Col AS INTEGER, Delta AS INTEGER)
    LOCAL R AS INTEGER
    LOCAL First AS INTEGER
    LOCAL LastOld AS INTEGER
    LOCAL EndedOld AS BOOLEAN
    LOCAL K AS INTEGER
    LOCAL N AS INTEGER
    LOCAL J AS INTEGER
    LOCAL S AS INTEGER
    LOCAL D AS INTEGER
    First = 0
    FOR R = 1 TO ROWS
        IF PgL(R) = L THEN
            IF First = 0 THEN
                First = R
            END IF
            LastOld = R
        END IF
    NEXT R
    IF First = 0 THEN
        NeedLayout = TRUE
        EXIT SUB
    END IF
    R = First
    WHILE R < LastOld AND PgE(R) <= Col
        R = R + 1
    WEND
    IF R > First THEN
        R = R - 1
    ELSE
        IF L = TopLine AND TopCol > 1 THEN
            NeedLayout = TRUE           ' the row above the page may change
            EXIT SUB
        END IF
    END IF
    EndedOld = PgLast(LastOld)
    N = 0
    K = R
    S = PgC(R)
    WHILE K <= ROWS
        IF K > R AND K <= LastOld THEN
            IF PgC(K) > Col AND S = PgC(K) + Delta THEN
                FOR J = 1 TO N
                    CALL PutNew(R + J - 1, L, J)
                NEXT J
                FOR J = K TO LastOld
                    PgC(J) = PgC(J) + Delta
                    PgE(J) = PgE(J) + Delta
                NEXT J
                EXIT SUB
            END IF
        END IF
        N = N + 1
        NewC(N) = S
        NewE(N) = NextBreak(L, S)
        NewLast(N) = BrLast
        IF BrLast THEN
            EXIT WHILE
        END IF
        S = NewE(N)
        K = K + 1
    WEND
    IF K > ROWS THEN                    ' the line fills the page from row R
        FOR J = 1 TO N
            CALL PutNew(R + J - 1, L, J)
        NEXT J
        EXIT SUB
    END IF
    ' the line now ends on page row K
    IF EndedOld AND K = LastOld THEN
        FOR J = 1 TO N
            CALL PutNew(R + J - 1, L, J)
        NEXT J
        EXIT SUB
    END IF
    IF NOT EndedOld THEN                ' it went on below the page before
        FOR J = 1 TO N
            CALL PutNew(R + J - 1, L, J)
        NEXT J
        CALL Layout(K + 1)
        EXIT SUB
    END IF
    IF K < LastOld THEN                 ' fewer rows: the rest moves up
        D = LastOld - K
        FOR J = LastOld + 1 TO ROWS
            CALL CopyRow(J - D, J)
        NEXT J
        FOR J = 1 TO N
            CALL PutNew(R + J - 1, L, J)
        NEXT J
        CALL Layout(ROWS - D + 1)
    ELSE                                ' more rows: the rest moves down
        D = K - LastOld
        FOR J = ROWS TO K + 1 STEP -1
            CALL CopyRow(J, J - D)
        NEXT J
        FOR J = 1 TO N
            CALL PutNew(R + J - 1, L, J)
        NEXT J
    END IF
END SUB

' Page row R from the new rows' J-th entry (RelayoutLine).
SUB PutNew(R AS INTEGER, L AS INTEGER, J AS INTEGER)
    PgL(R) = L
    PgC(R) = NewC(J)
    PgE(R) = NewE(J)
    PgLast(R) = NewLast(J)
    PgDirty(R) = TRUE
END SUB

SUB RowStart(Row AS INTEGER)
    RLast = FALSE
    IF NOT Wrap THEN
        RLine = TopLine + Row
        RCol = LeftCol
        EXIT SUB
    END IF
    IF PgL(Row + 1) = 0 THEN
        RLine = TEXTLINES(Doc) + 1
        RCol = 1
        RNext = 1
        EXIT SUB
    END IF
    RLine = PgL(Row + 1)
    RCol = PgC(Row + 1)
    RNext = PgE(Row + 1)
    RLast = PgLast(Row + 1)
END SUB

' How many characters the row RLine / RCol shows.
FUNCTION RowSize() AS INTEGER
    IF Wrap THEN
        RETURN RNext - RCol
    END IF
    RETURN COLS
END FUNCTION

' How much of Seg$ is drawn: cut at a whole character to at most TEXTW
' pixels (only a row's hanging space, or a row of very wide characters
' without wrap, is cut). A count, not the text: a FUNCTION's STRING holds
' 64 characters, a row 120.
FUNCTION FitLen() AS INTEGER
    LOCAL N AS INTEGER
    IF TEXTWIDTH(Seg$) <= TEXTW THEN
        RETURN LEN(Seg$)
    END IF
    N = LEN(Seg$) - 1
    WHILE N > 0 AND TEXTWIDTH(LEFT$(Seg$, N)) > TEXTW
        N = N - 1
    WEND
    RETURN N
END FUNCTION

' The x of the edge before character K + 1 of Seg$ (K characters in).
FUNCTION SegX(K AS INTEGER) AS INTEGER
    IF K <= 0 THEN
        RETURN 4
    END IF
    RETURN 4 + MIN(TEXTW, TEXTWIDTH(LEFT$(Seg$, K)))
END FUNCTION

' Draw the first N characters of Seg$ on the row at Y. DRAW TEXT shows at
' most (560 - x) \ 11 characters a call (its rule since M9: 11 pixels is
' font 7's widest glyph), so a row of more is drawn in pieces, each where
' the last one ended.
SUB DrawRun(Y AS INTEGER, N AS INTEGER)
    LOCAL K AS INTEGER
    LOCAL M AS INTEGER
    LOCAL X AS INTEGER
    K = 0
    X = 4
    WHILE K < N
        M = MIN(N - K, (560 - X) / 11)
        IF M <= 0 THEN
            EXIT WHILE
        END IF
        DRAW TEXT X, Y, MID$(Seg$, K + 1, M)
        K = K + M
        X = SegX(K)
    WEND
END SUB

' Draw page row Row: line RLine from column RCol (set by RowStart): the
' text normally spaced, then the selected characters inverted (and EOLW
' pixels more where the selection goes on past the line's end), then the
' caret as a 2-pixel bar just before its character. The caret sits on the
' row that shows its column; the column after a line's end is on the
' line's last row, the column after a continuing row's end on the next.
SUB DrawSeg(Row AS INTEGER)
    LOCAL Y AS INTEGER
    LOCAL Last AS INTEGER
    LOCAL A AS INTEGER
    LOCAL B AS INTEGER
    LOCAL XA AS INTEGER
    LOCAL XB AS INTEGER
    LOCAL Size AS INTEGER
    Y = Row * LINEH
    IF Wrap THEN
        PgDirty(Row + 1) = FALSE
    END IF
    DRAW FILL 0, Y, 560, LINEH, 8
    IF RLine > TEXTLINES(Doc) THEN
        EXIT SUB
    END IF
    Seg$ = ""
    Size = RowSize()
    IF RCol <= TEXTLEN(Doc, RLine) + 1 AND Size > 0 THEN
        Seg$ = TEXTGET$(Doc, RLine, RCol, Size)
    END IF
    Last = RCol + LEN(Seg$)
    IF Wrap AND NOT RLast THEN
        Last = RNext - 1
    END IF
    IF LEN(Seg$) > 0 THEN
        CALL DrawRun(Y, FitLen())
    END IF
    IF HasSel() THEN
        IF RLine >= S1 AND RLine <= S2 THEN
            A = RCol
            IF RLine = S1 THEN
                A = MAX(C1, RCol)
            END IF
            B = RCol + LEN(Seg$)
            XB = 0
            IF RLine = S2 THEN
                B = MIN(C2, B)
            ELSE
                IF B = TEXTLEN(Doc, RLine) + 1 AND (RLast OR (NOT Wrap AND LEN(Seg$) < COLS)) THEN
                    XB = EOLW               ' the line's end is selected too
                END IF
            END IF
            XA = SegX(A - RCol)
            XB = MIN(4 + TEXTW, SegX(B - RCol) + XB)
            IF XB > XA THEN
                DRAW INVERT XA, Y, XB - XA, LINEH
            END IF
        END IF
    END IF
    IF RLine = CurLine AND CurCol >= RCol AND CurCol <= Last THEN
        DRAW INVERT SegX(CurCol - RCol) - 1, Y, 2, LINEH
    END IF
END SUB

SUB DrawRow(Row AS INTEGER)
    CALL RowStart(Row)
    CALL DrawSeg(Row)
END SUB

' Redraw every row of line L that is on the page.
SUB DrawLine(L AS INTEGER)
    LOCAL R AS INTEGER
    IF L < TopLine OR L > TEXTLINES(Doc) THEN
        EXIT SUB
    END IF
    IF NOT Wrap THEN
        IF L - TopLine < ROWS THEN
            CALL DrawRow(L - TopLine)
        END IF
        EXIT SUB
    END IF
    FOR R = 1 TO ROWS
        IF PgL(R) = L THEN
            CALL DrawRow(R - 1)
        END IF
    NEXT R
END SUB

SUB Paint
    LOCAL Row AS INTEGER
    IF Wrap THEN
        CALL Follow                 ' measures the page first if needed
    END IF
    IF HasSel() THEN
        CALL SelRange
    END IF
    FOR Row = 0 TO ROWS - 1
        CALL DrawRow(Row)
    NEXT Row
    Redraw = FALSE
    CALL ShowStatus
END SUB

' The status line: "* " when unsaved, the position, " sel" or " mark",
' " nowrap" when wrap is off. A LABEL shows at most 24 characters (M5d);
' only extreme line or column numbers make it longer, and then its end
' (the least important part) is not shown.
SUB ShowStatus
    Seg$ = "L" + STR$(CurLine) + "/" + STR$(TEXTLINES(Doc)) + " C" + STR$(CurCol)
    IF Unsaved() THEN
        Seg$ = "* " + Seg$
    END IF
    IF Marking THEN
        Seg$ = Seg$ + " mark"
    ELSE
        IF HasSel() THEN
            Seg$ = Seg$ + " sel"
        END IF
    END IF
    IF NOT Wrap THEN
        Seg$ = Seg$ + " nowrap"
    END IF
    Status$ = LEFT$(Seg$, 24)
END SUB

FUNCTION Unsaved() AS BOOLEAN
    RETURN TEXTCHANGED(Doc) OR InTemp
END FUNCTION

' Keep the caret on the page; Redraw if the page moved. With wrap: the page
' is measured first if the text changed (NeedLayout); a caret one row
' above or below the page scrolls it by that row, one further away puts
' its row at the top.
SUB Follow
    LOCAL R AS INTEGER
    LOCAL S AS INTEGER
    LOCAL E AS INTEGER
    IF NOT Wrap THEN
        IF CurLine < TopLine THEN
            TopLine = CurLine
            Redraw = TRUE
        END IF
        IF CurLine >= TopLine + ROWS THEN
            TopLine = CurLine - ROWS + 1
            Redraw = TRUE
        END IF
        IF CurCol < LeftCol THEN
            LeftCol = MAX(1, CurCol - 8)
            Redraw = TRUE
        END IF
        IF CurCol > LeftCol + COLS - 1 THEN
            LeftCol = CurCol - COLS + 8
            Redraw = TRUE
        END IF
        EXIT SUB
    END IF
    LeftCol = 1
    IF NeedLayout THEN
        CALL FixTop
        CALL Layout(1)
        NeedLayout = FALSE
        Redraw = TRUE
    END IF
    IF CaretAt() > 0 THEN
        EXIT SUB
    END IF
    Redraw = TRUE
    IF CurLine < TopLine OR (CurLine = TopLine AND CurCol < TopCol) THEN
        S = RowOf(CurLine, CurCol)
        E = NextBreak(CurLine, S)
        IF (BrLast AND CurLine + 1 = TopLine AND TopCol = 1) OR (NOT BrLast AND CurLine = TopLine AND E = TopCol) THEN
            FOR R = ROWS TO 2 STEP -1   ' just above: down by one row
                CALL CopyRow(R, R - 1)
            NEXT R
            PgL(1) = CurLine
            PgC(1) = S
            PgE(1) = E
            PgLast(1) = BrLast
            TopLine = CurLine
            TopCol = S
            EXIT SUB
        END IF
        TopLine = CurLine
        TopCol = S
        CALL Layout(1)
        EXIT SUB
    END IF
    CALL After(ROWS)
    IF NL = CurLine AND NS <= CurCol THEN
        E = NextBreak(NL, NS)
        IF BrLast OR CurCol < E THEN    ' just below: up by one row
            FOR R = 1 TO ROWS - 1
                CALL CopyRow(R, R + 1)
            NEXT R
            PgL(ROWS) = NL
            PgC(ROWS) = NS
            PgE(ROWS) = E
            PgLast(ROWS) = BrLast
            TopLine = PgL(1)
            TopCol = PgC(1)
            EXIT SUB
        END IF
    END IF
    TopLine = CurLine
    TopCol = RowOf(CurLine, CurCol)
    CALL Layout(1)
END SUB

' After a change: the caret's rows, or the whole page when lines moved or
' a selection is shown; with wrap, a one-line edit is measured again from
' its row (RelayoutLine) and the rows it changed are drawn too.
SUB Refresh(OldLine AS INTEGER)
    LOCAL L AS INTEGER
    LOCAL R AS INTEGER
    LOCAL Measured AS BOOLEAN
    IF Redraw THEN
        NeedLayout = TRUE
    END IF
    Measured = FALSE
    IF Wrap AND EdOne AND NOT NeedLayout THEN
        CALL RelayoutLine(EdLine, EdCol, EdDelta)
        Measured = NOT NeedLayout
    END IF
    EdOne = FALSE
    CALL Follow
    IF Redraw THEN
        CALL Paint
        EXIT SUB
    END IF
    IF HasSel() THEN
        CALL SelRange
    END IF
    IF Measured AND NOT SelOn THEN
        ' a one-line edit: the rows it measured again (which hold the old
        ' caret) and the caret's row; the others did not change
        R = CaretAt()
        IF R > 0 THEN
            PgDirty(R) = TRUE
        END IF
    ELSE
        IF SelOn THEN               ' lines between the two caret lines change
            FOR L = MIN(OldLine, CurLine) TO MAX(OldLine, CurLine)
                CALL DrawLine(L)
            NEXT L
        ELSE
            IF OldLine <> CurLine THEN
                CALL DrawLine(OldLine)
            END IF
            CALL DrawLine(CurLine)
        END IF
    END IF
    IF Wrap THEN
        FOR R = 1 TO ROWS
            IF PgDirty(R) THEN
                CALL DrawRow(R - 1)
            END IF
        NEXT R
    END IF
    CALL ShowStatus
END SUB

SUB ClampCol
    IF CurCol > TEXTLEN(Doc, CurLine) + 1 THEN
        CurCol = TEXTLEN(Doc, CurLine) + 1
    END IF
END SUB

' ------------------------------------------------------------ undo / redo
' Snapshots H1..H4 form a ring; HTop is the newest. Undo swaps the text with
' the newest snapshot (so that snapshot then holds the redo state); redo
' swaps it back.
SUB SaveSlot(K AS INTEGER)
    SELECT CASE K
    CASE 1
        TEXT COPY H1, Doc
    CASE 2
        TEXT COPY H2, Doc
    CASE 3
        TEXT COPY H3, Doc
    CASE ELSE
        TEXT COPY H4, Doc
    END SELECT
    HLine(K) = CurLine
    HCol(K) = CurCol
END SUB

SUB SwapSlot(K AS INTEGER)
    LOCAL L AS INTEGER
    LOCAL C AS INTEGER
    TEXT COPY Swap, Doc
    SELECT CASE K
    CASE 1
        TEXT COPY Doc, H1
        TEXT COPY H1, Swap
    CASE 2
        TEXT COPY Doc, H2
        TEXT COPY H2, Swap
    CASE 3
        TEXT COPY Doc, H3
        TEXT COPY H3, Swap
    CASE ELSE
        TEXT COPY Doc, H4
        TEXT COPY H4, Swap
    END SELECT
    L = HLine(K)
    C = HCol(K)
    HLine(K) = CurLine
    HCol(K) = CurCol
    CurLine = MIN(MAX(1, L), TEXTLINES(Doc))
    CurCol = C
    CALL ClampCol
    TEXT CLEAR Swap
END SUB

' Start a new undo step (Kind: 1 typing, 2 deleting, 3 anything else); a
' typing or deleting run on the same line stays one step.
SUB Checkpoint(Kind AS INTEGER)
    IF Kind < 3 AND Kind = LastKind AND CurLine = LastLine THEN
        EXIT SUB
    END IF
    LastKind = Kind
    LastLine = CurLine
    HTop = HTop MOD STEPS + 1
    CALL SaveSlot(HTop)
    UndoN = MIN(UndoN + 1, STEPS)
    RedoN = 0
END SUB

SUB UndoStep
    LOCAL Old AS INTEGER
    IF UndoN = 0 THEN
        Info$ = "Nothing to undo"
        CALL ShowStatus
        EXIT SUB
    END IF
    Old = CurLine
    CALL SwapSlot(HTop)
    HTop = (HTop + STEPS - 2) MOD STEPS + 1
    UndoN = UndoN - 1
    RedoN = RedoN + 1
    LastKind = 0
    CALL ClearSel
    Info$ = "Undone"
    Redraw = TRUE
    CALL Refresh(Old)
END SUB

SUB RedoStep
    LOCAL Old AS INTEGER
    IF RedoN = 0 THEN
        Info$ = "Nothing to redo"
        CALL ShowStatus
        EXIT SUB
    END IF
    Old = CurLine
    HTop = HTop MOD STEPS + 1
    CALL SwapSlot(HTop)
    UndoN = UndoN + 1
    RedoN = RedoN - 1
    LastKind = 0
    CALL ClearSel
    Info$ = "Redone"
    Redraw = TRUE
    CALL Refresh(Old)
END SUB

SUB ForgetHistory
    UndoN = 0
    RedoN = 0
    HTop = 0
    LastKind = 0
END SUB

' ------------------------------------------------------------ editing
' Delete the selection (one undo step is already started by the caller).
SUB RemoveSel
    CALL SelRange
    TEXT REMOVE Doc, S1, C1, S2, C2
    CurLine = S1
    CurCol = C1
    SelOn = FALSE
    Marking = FALSE
    Redraw = TRUE
END SUB

SUB CopySel
    IF NOT HasSel() THEN
        Info$ = "Nothing selected"
        CALL ShowStatus
        EXIT SUB
    END IF
    CALL SelRange
    TEXT COPY Clip, Doc, S1, C1, S2, C2
    Info$ = "Copied"
    Marking = FALSE
    CALL Refresh(CurLine)
END SUB

SUB CutSel
    IF NOT HasSel() THEN
        Info$ = "Nothing selected"
        CALL ShowStatus
        EXIT SUB
    END IF
    CALL SelRange
    TEXT COPY Clip, Doc, S1, C1, S2, C2
    CALL Checkpoint(3)
    CALL RemoveSel
    Info$ = "Cut"
    CALL Refresh(CurLine)
END SUB

SUB PasteClip
    LOCAL Lines AS INTEGER
    IF TEXTSIZE(Clip) = 0 THEN
        Info$ = "Clipboard empty"
        CALL ShowStatus
        EXIT SUB
    END IF
    CALL Checkpoint(3)
    IF HasSel() THEN
        CALL RemoveSel
    END IF
    CALL ClearSel
    IF TEXTFREE(Doc) < TEXTSIZE(Clip) THEN
        Info$ = "No room"
        CALL ShowStatus
        EXIT SUB
    END IF
    Lines = TEXTLINES(Clip)
    TEXT PASTE Doc, CurLine, CurCol, Clip
    IF Lines = 1 THEN
        CurCol = CurCol + TEXTLEN(Clip, 1)
    ELSE
        CurLine = CurLine + Lines - 1
        CurCol = TEXTLEN(Clip, Lines) + 1
    END IF
    Info$ = "Pasted"
    Redraw = TRUE
    CALL Refresh(CurLine)
END SUB

' Select the whole text; the caret goes to the start (the page does not jump
' to the end), the anchor to the end.
SUB SelectAll
    SelOn = TRUE
    Marking = FALSE
    AncLine = TEXTLINES(Doc)
    AncCol = TEXTLEN(Doc, AncLine) + 1
    CurLine = 1
    CurCol = 1
    LastKind = 0
    Redraw = TRUE
    CALL Refresh(CurLine)
END SUB

SUB MarkSel
    IF Marking THEN
        Marking = FALSE
        Info$ = "Mark off"
    ELSE
        Marking = TRUE
        SelOn = TRUE
        AncLine = CurLine
        AncCol = CurCol
        Info$ = "Mark on"
    END IF
    Redraw = TRUE
    CALL Refresh(CurLine)
END SUB

SUB ToggleWrap
    Wrap = NOT Wrap
    LeftCol = 1
    TopCol = 1
    NeedLayout = TRUE
    Redraw = TRUE
    CALL Refresh(CurLine)
END SUB

' A typed text: replaces the selection, else goes in at the caret.
SUB TypeText(T$ AS STRING)
    IF HasSel() THEN
        CALL Checkpoint(3)
        CALL RemoveSel
        LastKind = 1                ' the typing that follows is the same step
        LastLine = CurLine
    ELSE
        CALL Checkpoint(1)
    END IF
    CALL ClearSel
    IF TEXTFREE(Doc) < LEN(T$) THEN
        Info$ = "The text is full"
        EXIT SUB
    END IF
    TEXT INSERT Doc, CurLine, CurCol, T$
    EdOne = TRUE                    ' a one-line edit (Refresh, RelayoutLine)
    EdLine = CurLine
    EdCol = CurCol
    EdDelta = LEN(T$)
    CurCol = CurCol + LEN(T$)
END SUB

' ------------------------------------------------------------- keys
SUB Keys
    LOCAL Old AS INTEGER
    LOCAL K AS INTEGER
    Old = CurLine
    K = KEYCODE
    IF (KEYSHIFT AND 4) <> 0 AND K <> 230 AND K <> 231 THEN
        EXIT SUB                    ' a Ctrl key belongs to the menus (KI-60)
    END IF
    IF K <> 224 AND K <> 225 THEN
        GoalOn = FALSE
    END IF
    Info$ = ""
    SELECT CASE K
    CASE 241
        CALL MarkSel
        EXIT SUB
    CASE 32 TO 126, 128 TO 223
        CALL TypeText(CHR$(K))
    CASE 9
        CALL TypeText("    ")
    CASE 13
        CALL Checkpoint(3)
        IF HasSel() THEN
            CALL RemoveSel
        END IF
        CALL ClearSel
        IF TEXTFREE(Doc) < 2 THEN
            Info$ = "The text is full"
        ELSE
            TEXT SPLIT Doc, CurLine, CurCol
            CurLine = CurLine + 1
            CurCol = 1
            Redraw = TRUE
        END IF
    CASE 8, 229
        IF HasSel() THEN
            CALL Checkpoint(3)
            CALL RemoveSel
        ELSE
            CALL ClearSel
            CALL DeleteChar(K)
        END IF
    CASE 224 TO 233
        CALL BeforeMove
        CALL MoveCaret(K)
    CASE 254
        CALL QuitEditor
        EXIT SUB
    CASE ELSE
        EXIT SUB
    END SELECT
    CALL Refresh(Old)
END SUB

' A one-line edit at column Col that changed the line's length by Delta.
SUB EditAt(Col AS INTEGER, Delta AS INTEGER)
    EdOne = TRUE
    EdLine = CurLine
    EdCol = Col
    EdDelta = Delta
END SUB

SUB DeleteChar(K AS INTEGER)
    IF K = 8 THEN
        IF CurCol > 1 THEN
            CALL Checkpoint(2)
            CurCol = CurCol - 1
            TEXT DELETE Doc, CurLine, CurCol, 1
            CALL EditAt(CurCol, -1)
        ELSE
            IF CurLine > 1 THEN
                CALL Checkpoint(3)
                CurLine = CurLine - 1
                CurCol = TEXTLEN(Doc, CurLine) + 1
                TEXT JOIN Doc, CurLine
                Redraw = TRUE
            END IF
        END IF
        EXIT SUB
    END IF
    IF CurCol <= TEXTLEN(Doc, CurLine) THEN
        CALL Checkpoint(2)
        TEXT DELETE Doc, CurLine, CurCol, 1
        CALL EditAt(CurCol, -1)
    ELSE
        IF CurLine < TEXTLINES(Doc) THEN
            CALL Checkpoint(3)
            TEXT JOIN Doc, CurLine
            Redraw = TRUE
        END IF
    END IF
END SUB

' Up / Down with wrap: to the row above or below, at the character edge
' nearest the caret's x when the run of Up / Down presses began (GoalX).
SUB RowMove(D AS INTEGER)
    LOCAL R AS INTEGER
    LOCAL TL AS INTEGER
    LOCAL TS AS INTEGER
    LOCAL TE AS INTEGER
    LOCAL TLast AS BOOLEAN
    R = CaretAt()
    IF R = 0 THEN
        EXIT SUB
    END IF
    IF NOT GoalOn THEN
        CALL RowStart(R - 1)
        Seg$ = ""
        IF RowSize() > 0 THEN
            Seg$ = TEXTGET$(Doc, RLine, RCol, RowSize())
        END IF
        GoalX = SegX(CurCol - RCol) - 4
        GoalOn = TRUE
    END IF
    IF D < 0 THEN
        IF R > 1 THEN
            TL = PgL(R - 1)
            TS = PgC(R - 1)
            TE = PgE(R - 1)
            TLast = PgLast(R - 1)
        ELSE
            IF TopCol > 1 THEN
                TL = TopLine
                TS = RowOf(TopLine, TopCol - 1)
                TE = TopCol
                TLast = FALSE
            ELSE
                IF TopLine = 1 THEN
                    EXIT SUB
                END IF
                TL = TopLine - 1
                TS = RowOf(TL, TEXTLEN(Doc, TL) + 1)
                TE = TEXTLEN(Doc, TL) + 1
                TLast = TRUE
            END IF
        END IF
    ELSE
        IF R < ROWS THEN
            IF PgL(R + 1) = 0 THEN
                EXIT SUB
            END IF
            TL = PgL(R + 1)
            TS = PgC(R + 1)
            TE = PgE(R + 1)
            TLast = PgLast(R + 1)
        ELSE
            CALL After(ROWS)
            IF NL = 0 THEN
                EXIT SUB
            END IF
            TL = NL
            TS = NS
            TE = NextBreak(NL, NS)
            TLast = BrLast
        END IF
    END IF
    RLine = TL
    RCol = TS
    RNext = TE
    RLast = TLast
    CurLine = TL
    CurCol = TS + ColAt(GoalX)
    IF NOT TLast AND CurCol > TE - 1 THEN
        CurCol = TE - 1
    END IF
    CALL ClampCol
END SUB

SUB MoveCaret(K AS INTEGER)
    SELECT CASE K
    CASE 224
        IF Wrap THEN
            CALL RowMove(-1)
        ELSE
            IF CurLine > 1 THEN
                CurLine = CurLine - 1
                CALL ClampCol
            END IF
        END IF
    CASE 225
        IF Wrap THEN
            CALL RowMove(1)
        ELSE
            IF CurLine < TEXTLINES(Doc) THEN
                CurLine = CurLine + 1
                CALL ClampCol
            END IF
        END IF
    CASE 226
        IF CurCol > 1 THEN
            CurCol = CurCol - 1
        ELSE
            IF CurLine > 1 THEN
                CurLine = CurLine - 1
                CurCol = TEXTLEN(Doc, CurLine) + 1
            END IF
        END IF
    CASE 227
        IF CurCol <= TEXTLEN(Doc, CurLine) THEN
            CurCol = CurCol + 1
        ELSE
            IF CurLine < TEXTLINES(Doc) THEN
                CurLine = CurLine + 1
                CurCol = 1
            END IF
        END IF
    CASE 230
        CurCol = 1
        IF (KEYSHIFT AND 4) <> 0 THEN
            CurLine = 1
        END IF
    CASE 231
        IF (KEYSHIFT AND 4) <> 0 THEN
            CurLine = TEXTLINES(Doc)
        END IF
        CurCol = TEXTLEN(Doc, CurLine) + 1
    CASE 232
        CurLine = MAX(1, CurLine - ROWS)
        TopLine = MAX(1, TopLine - ROWS)
        TopCol = 1
        CALL ClampCol
        Redraw = TRUE
    CASE ELSE
        CurLine = MIN(TEXTLINES(Doc), CurLine + ROWS)
        TopLine = MIN(MAX(1, TEXTLINES(Doc) - ROWS + 1), TopLine + ROWS)
        TopCol = 1
        CALL ClampCol
        Redraw = TRUE
    END SELECT
END SUB

' The character edge on row RLine / RCol nearest pixel MX of the text (0 =
' before its first character): the first character whose middle MX has not
' passed, measured as DrawSeg draws them.
FUNCTION ColAt(MX AS INTEGER) AS INTEGER
    LOCAL K AS INTEGER
    LOCAL W AS INTEGER
    LOCAL A AS INTEGER
    LOCAL Size AS INTEGER
    Seg$ = ""
    Size = RowSize()
    IF RCol <= TEXTLEN(Doc, RLine) + 1 AND Size > 0 THEN
        Seg$ = TEXTGET$(Doc, RLine, RCol, Size)
    END IF
    K = 0
    W = 0
    WHILE K < LEN(Seg$)
        A = TEXTWIDTH(MID$(Seg$, K + 1, 1))
        IF 2 * MX < 2 * W + A THEN
            RETURN K
        END IF
        W = W + A
        K = K + 1
    WEND
    RETURN K
END FUNCTION

' A press puts the caret at the character edge nearest the pointer (and the
' anchor there); dragging with the button down moves the caret, selecting
' from the anchor; the release ends it. Outside the page: the nearest row.
SUB Mouse
    LOCAL Old AS INTEGER
    LOCAL Row AS INTEGER
    Old = CurLine
    GoalOn = FALSE
    SELECT CASE MOUSEEVENT
    CASE 1
        CALL ClearSel
        Dragging = TRUE
    CASE 2
        IF NOT Dragging THEN
            EXIT SUB
        END IF
    CASE ELSE
        IF NOT Dragging THEN
            EXIT SUB
        END IF
        Dragging = FALSE
    END SELECT
    Row = MIN(ROWS - 1, MAX(0, MOUSEY) / LINEH)
    CALL RowStart(Row)
    IF RLine > TEXTLINES(Doc) THEN
        CurLine = TEXTLINES(Doc)
        CurCol = TEXTLEN(Doc, CurLine) + 1
    ELSE
        CurLine = RLine
        CurCol = RCol + ColAt(MOUSEX - 4)
        IF Wrap AND NOT RLast AND CurCol > RNext - 1 THEN
            CurCol = RNext - 1          ' a continuing row's end is the next row's start
        END IF
        CALL ClampCol
    END IF
    IF MOUSEEVENT = 1 THEN
        AncLine = CurLine
        AncCol = CurCol
    ELSE
        IF CurLine <> AncLine OR CurCol <> AncCol THEN
            SelOn = TRUE
        END IF
    END IF
    LastKind = 0
    CALL Refresh(Old)
END SUB

' ------------------------------------------------------------- files
SUB StartDoc
    CurLine = 1
    CurCol = 1
    TopLine = 1
    TopCol = 1
    NeedLayout = TRUE
    LeftCol = 1
    SelOn = FALSE
    Marking = FALSE
    Redraw = TRUE
    CALL ForgetHistory
END SUB

SUB LoadFile
    TEXT LOAD Doc, FileName$
    N = IOERR
    CALL StartDoc
    InTemp = FALSE
    DocName$ = ""
    SELECT CASE N
    CASE 0
        DocName$ = FileName$
        Info$ = "Opened " + FileName$
    CASE 2
        DocName$ = FileName$
        Info$ = "New file " + FileName$
    CASE 247
        Info$ = "Not opened"
        MESSAGE "Bad name [" + FileName$ + "]"
    CASE 246
        Info$ = "Too big"
        MESSAGE FileName$ + ": over 30000 bytes"
    CASE ELSE
        Info$ = "Not opened"
        MESSAGE FileName$ + ": error " + STR$(N)
    END SELECT
END SUB

' BakName$ = Target$ with the extension .BAK; FALSE if it would be Target$.
FUNCTION MakeBakName() AS BOOLEAN
    LOCAL Dot AS INTEGER
    Dot = INSTR(Target$, ".")
    IF Dot = 0 THEN
        BakName$ = Target$ + ".BAK"
    ELSE
        BakName$ = LEFT$(Target$, Dot - 1) + ".BAK"
    END IF
    RETURN UCASE$(BakName$) <> UCASE$(Target$)
END FUNCTION

' 1 write TEMPNAME; 2 read it back into Swap and compare; 3 rename the file
' to NAME.BAK (if that fails but not for a missing file, delete NAME.BAK and
' rename again; if the file is missing, keep NAME.BAK); 5 rename TEMPNAME to
' the file.
' A failure in 1 or 2 leaves everything as it was; later, the text stays in
' TEMPNAME and the document stays marked as unsaved.
SUB WriteFile
    IF LEN(Target$) = 0 THEN
        MESSAGE "No name: use Save as"
        EXIT SUB
    END IF
    IF NOT MakeBakName() THEN
        MESSAGE "Not .BAK: " + Target$
        EXIT SUB
    END IF
    IF Stale THEN
        MESSAGE "Not saved: " + TEMPNAME + " and " + OLDNAME + " hold unfinished saves"
        Info$ = "Not saved"
        EXIT SUB
    END IF
    TEXT SAVE Doc, TEMPNAME
    N = IOERR
    IF N <> 0 THEN
        MESSAGE "Not saved (" + STR$(N) + ")"
        KILL TEMPNAME
        Info$ = "Not saved"
        EXIT SUB
    END IF
    InTemp = TRUE
    TEXT LOAD Swap, TEMPNAME
    N = IOERR
    IF N = 0 AND NOT TEXTSAME(Swap, Doc) THEN
        N = 251
    END IF
    TEXT CLEAR Swap
    IF N <> 0 THEN
        MESSAGE "Not saved: check failed (" + STR$(N) + ")"
        KILL TEMPNAME
        InTemp = FALSE
        Info$ = "Not saved"
        EXIT SUB
    END IF
    NAME Target$ AS BakName$
    N = IOERR
    IF N <> 0 AND N <> 2 THEN
        KILL BakName$
        N = IOERR
        IF N = 0 THEN
            NAME Target$ AS BakName$
            N = IOERR
        END IF
    END IF
    IF N <> 0 AND N <> 2 THEN
        MESSAGE "Only in " + TEMPNAME + " (" + STR$(N) + ")"
        Info$ = "In " + TEMPNAME
        EXIT SUB
    END IF
    NAME TEMPNAME AS Target$
    N = IOERR
    IF N <> 0 THEN
        MESSAGE "Only in " + TEMPNAME + "; old in " + BakName$ + " (" + STR$(N) + ")"
        Info$ = "In " + TEMPNAME
        EXIT SUB
    END IF
    InTemp = FALSE
    DocName$ = Target$
    Info$ = "Saved " + Target$
END SUB

SUB SaveDoc
    Target$ = DocName$
    CALL WriteFile
    CALL ShowStatus
END SUB

FUNCTION MayDiscard() AS BOOLEAN
    IF NOT Unsaved() THEN
        RETURN TRUE
    END IF
    Answer = ASK("Unsaved changes", "Save", "Discard", "Cancel")
    IF Answer = 1 THEN
        Target$ = DocName$
        CALL WriteFile
        RETURN NOT Unsaved()
    END IF
    RETURN Answer = 2
END FUNCTION

SUB QuitEditor
    IF MayDiscard() THEN
        EXIT
    END IF
END SUB

SUB ShowTools
    GoLine = CurLine
    FileName$ = DocName$
    SHOW Tools
END SUB

SUB ShowFinder
    SHOW Finder
END SUB

SUB BackToMain
    SHOW Main
END SUB

SUB OpenDoc
    IF LEN(FileName$) = 0 THEN
        MESSAGE "Type a name"
        EXIT SUB
    END IF
    IF MayDiscard() THEN
        CALL LoadFile
    END IF
    SHOW Main
END SUB

SUB SaveAs
    IF LEN(FileName$) = 0 THEN
        MESSAGE "Type a name"
        EXIT SUB
    END IF
    Answer = ASK("Replace " + FileName$ + "?", "Save", "Cancel")
    IF Answer = 1 THEN
        Target$ = FileName$
        CALL WriteFile
    END IF
    SHOW Main
END SUB

' ------------------------------------------------------- find / replace
FUNCTION SearchFrom(Line AS INTEGER, Col AS INTEGER) AS BOOLEAN
    IF LEN(FindText$) = 0 THEN
        Info$ = "Nothing to find"
        RETURN FALSE
    END IF
    N = TEXTFIND(Doc, FindText$, Line, Col)
    IF N = 0 THEN
        Info$ = "Not found"
        RETURN FALSE
    END IF
    CurLine = N
    CurCol = TEXTCOL(Doc)
    Info$ = "Found"
    CALL ClearSel
    CALL Follow
    Redraw = TRUE
    RETURN TRUE
END FUNCTION

FUNCTION SearchNext() AS BOOLEAN
    IF CurCol <= TEXTLEN(Doc, CurLine) THEN
        RETURN SearchFrom(CurLine, CurCol + 1)
    END IF
    IF CurLine < TEXTLINES(Doc) THEN
        RETURN SearchFrom(CurLine + 1, 1)
    END IF
    Info$ = "Not found"
    RETURN FALSE
END FUNCTION

SUB FindFirst
    IF SearchFrom(1, 1) THEN
        LastKind = 0
    END IF
    SHOW Main
END SUB

SUB FindNext
    LOCAL Old AS INTEGER
    Old = CurLine
    IF SearchNext() THEN
        LastKind = 0
    END IF
    CALL Refresh(Old)
END SUB

' TRUE if the caret is at an occurrence of FindText$.
FUNCTION AtMatch() AS BOOLEAN
    IF LEN(FindText$) = 0 THEN
        RETURN FALSE
    END IF
    RETURN TEXTGET$(Doc, CurLine, CurCol, LEN(FindText$)) = FindText$
END FUNCTION

' Replace the occurrence at the caret (else find the first one), then move
' to the next.
SUB ReplaceOne
    IF NOT AtMatch() THEN
        IF NOT SearchFrom(CurLine, CurCol) THEN
            SHOW Main
            EXIT SUB
        END IF
    END IF
    IF TEXTFREE(Doc) < LEN(ReplText$) THEN
        Info$ = "No room"
        SHOW Main
        EXIT SUB
    END IF
    CALL Checkpoint(3)
    TEXT DELETE Doc, CurLine, CurCol, LEN(FindText$)
    TEXT INSERT Doc, CurLine, CurCol, ReplText$
    NeedLayout = TRUE
    CurCol = CurCol + LEN(ReplText$)
    Info$ = "Replaced"
    IF SearchFrom(CurLine, CurCol) THEN
        Info$ = "Replaced"
    END IF
    Redraw = TRUE
    SHOW Main
END SUB

SUB ReplaceAll
    LOCAL Count AS INTEGER
    LOCAL L AS INTEGER
    LOCAL C AS INTEGER
    IF LEN(FindText$) = 0 THEN
        Info$ = "Nothing to find"
        SHOW Main
        EXIT SUB
    END IF
    CALL Checkpoint(3)
    Count = 0
    L = 1
    C = 1
    N = TEXTFIND(Doc, FindText$, L, C)
    WHILE N > 0
        IF TEXTFREE(Doc) < LEN(ReplText$) THEN
            MESSAGE "Full after " + STR$(Count)
            EXIT WHILE
        END IF
        L = N
        C = TEXTCOL(Doc)
        TEXT DELETE Doc, L, C, LEN(FindText$)
        TEXT INSERT Doc, L, C, ReplText$
        Count = Count + 1
        C = C + LEN(ReplText$)
        N = TEXTFIND(Doc, FindText$, L, C)
    WEND
    Info$ = "Replaced " + STR$(Count)
    NeedLayout = TRUE
    CALL ClearSel
    CALL ClampCol
    Redraw = TRUE
    SHOW Main
END SUB

SUB GoToLine
    CurLine = MIN(MAX(1, GoLine), TEXTLINES(Doc))
    CurCol = 1
    CALL ClearSel
    CALL Follow
    Redraw = TRUE
    SHOW Main
END SUB

' An MDEDIT4.TMP left by an unfinished save is kept as MDEDIT4.OLD.
SUB KeepUnfinished
    NAME TEMPNAME AS OLDNAME
    SELECT CASE IOERR
    CASE 0
        MESSAGE "An unfinished save was kept as " + OLDNAME + ": open it to recover it"
    CASE 2
    CASE ELSE
        Stale = TRUE
        MESSAGE TEMPNAME + " and " + OLDNAME + " hold unfinished saves: saving is off until one is deleted"
    END SELECT
END SUB

Wrap = TRUE
CALL KeepUnfinished
FileName$ = "EDTEST.MD"
CALL LoadFile
END
