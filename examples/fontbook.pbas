' Font book (M15 example): Rosanne's twelve dialog fonts on a canvas.
' Each page shows six fonts with their measured widths (TEXTWIDTH in that
' font) and a tick where the text ends; Align shows DRAW TEXT ... ALIGN LEFT,
' CENTRE and RIGHT about a line. Font 7 is the one windows use and the
' default; DRAW FONT n chooses another for later DRAW TEXT and TEXTWIDTH.
' Fonts 11 and 12 are Rosanne's own special-looking designs.
DIM Page AS INTEGER
DIM N AS INTEGER
DIM W AS INTEGER
DIM Y AS INTEGER
DIM T$ AS STRING * 40
WINDOW "Font book", LARGE
CANVAS 560, 270, PAINT Draw
BUTTON "Fonts 1-6", Page1
BUTTON "Fonts 7-12", Page2
BUTTON "Align", Page3
BUTTON "Quit", Quit
MENU "File"
    ITEM "Quit", Quit
END MENU

SUB Draw
    DRAW CLEAR
    IF Page = 3 THEN
        DRAW LINE 280, 0, 280, 269
        FOR N = 1 TO 3
            DRAW FONT N * 4 - 1
            Y = N * 80 - 72
            DRAW TEXT 280, Y, "Left of font " + STR$(N * 4 - 1) ALIGN LEFT
            DRAW TEXT 280, Y + 22, "Centred" ALIGN CENTRE
            DRAW TEXT 280, Y + 44, "Right" ALIGN RIGHT
        NEXT N
        EXIT SUB
    END IF
    Y = 6
    FOR N = Page * 6 - 5 TO Page * 6
        DRAW FONT N
        T$ = "Font " + STR$(N) + ": Pack my box"
        W = TEXTWIDTH(T$)
        DRAW TEXT 8, Y, T$
        DRAW LINE 8 + W, Y, 8 + W, Y + 12
        DRAW FONT 7
        DRAW TEXT 552, Y, STR$(W) + " px" ALIGN RIGHT
        Y = Y + 44
    NEXT N
END SUB

SUB Page1
    Page = 1
    CALL Draw
END SUB

SUB Page2
    Page = 2
    CALL Draw
END SUB

SUB Page3
    Page = 3
    CALL Draw
END SUB

SUB Quit
    EXIT
END SUB

Page = 1
END
