' while_wait.pbas: WHILE loops that grow, then shrink, a value (M2, no GUI).
' XAnne shows two alerts in order: "Doubled to 64 in 6 rises", then "Shrunk to 1".
DIM Level AS INTEGER
DIM Rises AS INTEGER
DIM Low AS BOOLEAN
Level = 1
Rises = 0
WHILE Level < 40
    Level = Level + Level       ' 2, 4, 8, 16, 32, 64: grows past the threshold
    Rises = Rises + 1
WEND
MESSAGE "Doubled to " + STR$(Level) + " in " + STR$(Rises) + " rises"
Low = Level > 3
WHILE Low                       ' condition refreshed inside the loop
    Level = Level - 9           ' 55, 46, 37, 28, 19, 10, 1
    Low = Level > 3
WEND
MESSAGE "Shrunk to " + STR$(Level)
END
