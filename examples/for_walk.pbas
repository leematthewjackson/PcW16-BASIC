' for_walk.pbas: FOR up, FOR down (STEP -1), and a zero-trip FOR (M2, no GUI).
' XAnne shows three alerts in order: "Up: 30", "Down: 15", "Empty: 99".
DIM Leg AS INTEGER
DIM Miles AS INTEGER
FOR Leg = 1 TO 5
    Miles = Miles + Leg * 2     ' 2+4+6+8+10 ascending accumulation
NEXT Leg
MESSAGE "Up: " + STR$(Miles)
Miles = 0
FOR Leg = 5 TO 1 STEP -1
    Miles = Miles + Leg         ' 5+4+3+2+1 descending accumulation
NEXT Leg
MESSAGE "Down: " + STR$(Miles)
Miles = 99
FOR Leg = 3 TO 8 STEP -1        ' start below finish with STEP -1: never runs
    Miles = Miles + 1
NEXT Leg
MESSAGE "Empty: " + STR$(Miles)
END
